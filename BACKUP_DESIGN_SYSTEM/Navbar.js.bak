'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { motion, AnimatePresence } from 'framer-motion';
import { useSession, signOut } from "next-auth/react";

export default function Navbar() {
  const { data: session } = useSession();
  const [isVisible, setIsVisible] = useState(true);
  const [isHovered, setIsHovered] = useState(false);
  const [isDark, setIsDark] = useState(false);
  const [lastScrollY, setLastScrollY] = useState(0);
  const [showAccessModal, setShowAccessModal] = useState(false);
  const [mounted, setMounted] = useState(false);
  const pathname = usePathname();

  useEffect(() => {
    setMounted(true);
  }, []);

  useEffect(() => {
    const handleScroll = () => {
      const currentScrollY = window.scrollY;
      setIsVisible(true);
      setLastScrollY(currentScrollY);

      const elementUnderNavbar = document.elementFromPoint(window.innerWidth / 2, 40);
      if (elementUnderNavbar) {
        const section = elementUnderNavbar.closest('[data-navbar-theme]');
        setIsDark(section?.getAttribute('data-navbar-theme') === 'dark');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleScroll);
    handleScroll();

    return () => {
      window.removeEventListener('scroll', handleScroll);
      window.removeEventListener('resize', handleScroll);
    };
  }, []);

  const [isMenuOpen, setIsMenuOpen] = useState(false);

  useEffect(() => {
    if (isMenuOpen) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = 'unset';
    }
  }, [isMenuOpen]);

  const handleRestrictedAccess = (e) => {
    const user = session?.user;
    const isAuthorized = user && (user.role === 'Admin' || user.role === 'Editor' || user.isActive);

    if (!isAuthorized) {
      e.preventDefault();
      setShowAccessModal(true);
      if (isMenuOpen) setIsMenuOpen(false);
      return false;
    }
    if (isMenuOpen) setIsMenuOpen(false);
    return true;
  };

  const handleLogoClick = () => {
    if (pathname === '/') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  };

  return (
    <>
      <AnimatePresence>
        {mounted && (isVisible || isHovered || isMenuOpen) && (
          <motion.header 
            initial={{ y: -100, opacity: 0 }}
            animate={{ y: 0, opacity: 1 }}
            exit={{ y: -100, opacity: 0 }}
            transition={{ type: 'spring', stiffness: 260, damping: 20 }}
            className="fixed top-6 left-0 w-full z-50 px-6 flex justify-center pointer-events-none"
          >
            <div 
              className={`pointer-events-auto flex items-center justify-between px-4 md:px-8 py-2 md:py-3 rounded-full transition-all duration-700 max-w-7xl w-full border ${
                isMenuOpen 
                  ? 'bg-primary border-white/10' 
                  : 'bg-[#fdf9e1]/90 backdrop-blur-2xl border-slate-200 shadow-[0_20px_50px_rgba(0,0,0,0.1)]'
              } group/navbar`}
              onMouseEnter={() => setIsHovered(true)}
              onMouseLeave={() => setIsHovered(false)}
            >
              {/* Logo Area */}
              <div className="flex items-center gap-4">
                <Link 
                  href="/" 
                  onClick={handleLogoClick}
                  className="group relative cursor-pointer block h-[50px] md:h-[60px] w-auto"
                >
                  <motion.img 
                    src={isMenuOpen ? "/logo_top_bar.png" : "/logo-final.png"}
                    alt="S2 PROJECT" 
                    whileHover={{ scale: 1.05 }}
                    transition={{ duration: 0.2 }}
                    className="h-full w-auto object-contain"
                  />
                </Link>
              </div>

              {/* Desktop Navigation */}
              <div className="hidden md:flex items-center gap-1 bg-black/5 p-1 rounded-full relative">
                <NavbarLink href="/" isDark={false}>Inicio</NavbarLink>
                <NavbarLink href="/servicios" isDark={false}>Servicios</NavbarLink>
                <NavbarLink href="/portafolio" isDark={false} onClick={handleRestrictedAccess}>Portafolio</NavbarLink>
                <NavbarLink href="/proceso" isDark={false}>Proceso</NavbarLink>
                <NavbarLink href="/nosotros" isDark={false}>Nosotros</NavbarLink>
                <NavbarLink href="/admin/dashboard" isDark={false}>Admin</NavbarLink>
              </div>

              {/* Mobile Controls */}
              <div className="flex items-center gap-4">
                <button 
                  onClick={() => setIsMenuOpen(!isMenuOpen)}
                  className={`md:hidden flex items-center justify-center w-10 h-10 rounded-full transition-colors ${isMenuOpen ? 'bg-primary text-white' : 'bg-slate-900/5 text-slate-900'}`}
                  aria-label="Toggle Menu"
                >
                  <div className="flex flex-col gap-1 w-5 items-center">
                    <motion.span 
                      animate={{ 
                        rotate: isMenuOpen ? 45 : 0, 
                        y: isMenuOpen ? 5 : 0,
                        backgroundColor: isMenuOpen ? "#ffffff" : "#1d2729"
                      }}
                      className="h-0.5 w-full rounded-full"
                    />
                    <motion.span 
                      animate={{ 
                        opacity: isMenuOpen ? 0 : 1,
                        backgroundColor: isMenuOpen ? "#ffffff" : isDark ? "#ffffff" : "#0f172a"
                      }}
                      className="h-0.5 w-full rounded-full"
                    />
                    <motion.span 
                      animate={{ 
                        rotate: isMenuOpen ? -45 : 0, 
                        y: isMenuOpen ? -5 : 0,
                        backgroundColor: isMenuOpen ? "#ffffff" : isDark ? "#ffffff" : "#0f172a"
                      }}
                      className="h-0.5 w-full rounded-full"
                    />
                  </div>
                </button>
              </div>
            </div>
          </motion.header>
        )}
      </AnimatePresence>

      {/* Mobile Menu Overlay */}
      <AnimatePresence>
        {isMenuOpen && (
          <motion.div
            initial={{ opacity: 0, backdropFilter: 'blur(0px)' }}
            animate={{ opacity: 1, backdropFilter: 'blur(20px)' }}
            exit={{ opacity: 0, backdropFilter: 'blur(0px)' }}
            className="fixed inset-0 z-[45] bg-black/60 md:hidden flex flex-col items-center justify-center"
          >
             <nav className="flex flex-col items-center gap-8">
                <MobileNavLink href="/" onClick={() => setIsMenuOpen(false)}>Inicio</MobileNavLink>
                <MobileNavLink href="/servicios" onClick={() => setIsMenuOpen(false)}>Servicios</MobileNavLink>
                <MobileNavLink href="/portafolio" onClick={handleRestrictedAccess}>Portafolio</MobileNavLink>
                <MobileNavLink href="/proceso" onClick={() => setIsMenuOpen(false)}>Proceso</MobileNavLink>
                <MobileNavLink href="/nosotros" onClick={() => setIsMenuOpen(false)}>Nosotros</MobileNavLink>
                <MobileNavLink href="/admin/dashboard" onClick={() => setIsMenuOpen(false)}>Admin</MobileNavLink>
             </nav>
          </motion.div>
        )}
      </AnimatePresence>

      <AccessProtectionModal isOpen={showAccessModal} onClose={() => setShowAccessModal(false)} />
    </>
  );
}

function AccessProtectionModal({ isOpen, onClose }) {
  return (
    <AnimatePresence>
      {isOpen && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          className="fixed inset-0 z-[1000] flex items-center justify-center p-6 bg-slate-900/80 backdrop-blur-md"
        >
          <motion.div
            initial={{ scale: 0.9, y: 20 }}
            animate={{ scale: 1, y: 0 }}
            exit={{ scale: 0.9, y: 20 }}
            className="bg-white w-full max-w-lg rounded-3xl p-8 md:p-10 shadow-2xl border border-primary/20 relative"
          >
            <button 
              onClick={onClose}
              className="absolute top-6 right-6 w-10 h-10 flex items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 transition-colors"
            >
              <span className="material-symbols-outlined">close</span>
            </button>
            <div className="w-16 h-16 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-6">
              <span className="material-symbols-outlined text-3xl">lock</span>
            </div>
            <h3 className="text-2xl font-display font-black uppercase text-slate-900 mb-4">Acceso Restringido</h3>
            <p className="text-slate-500 text-sm mb-8">Nuestros portafolios privados requieren autorización.</p>
            <div className="space-y-3">
               <a href="https://api.whatsapp.com/send?phone=50660060026" className="flex items-center justify-center gap-3 w-full p-4 rounded-xl bg-primary text-white font-bold text-sm">WhatsApp</a>
            </div>
          </motion.div>
        </motion.div>
      )}
    </AnimatePresence>
  );
}

function NavbarLink({ href, children, isDark, onClick }) {
  const pathname = usePathname();
  const isActive = pathname === href;
  
  return (
    <Link 
      href={href} 
      onClick={onClick}
      className={`relative px-5 py-2 rounded-full transition-all duration-300 group/link overflow-hidden flex items-center justify-center ${
        isActive 
          ? 'bg-primary text-white shadow-lg' 
          : isDark 
            ? 'text-white/70 hover:text-white' 
            : 'text-slate-900 hover:text-primary'
      }`}
    >
      <span className="relative z-10 text-[10px] font-black uppercase tracking-[0.2em] font-display">
        {children}
      </span>
      {!isActive && (
        <motion.span 
          initial={false}
          className={`absolute inset-0 z-0 scale-0 group-hover/link:scale-100 transition-transform duration-500 rounded-full ${isDark ? 'bg-white/10' : 'bg-primary/10'}`}
        />
      )}
    </Link>
  );
}

function MobileNavLink({ href, children, onClick }) {
  const pathname = usePathname();
  const isActive = pathname === href;
  return (
    <Link 
      href={href} 
      onClick={onClick}
      className={`text-3xl font-display font-black uppercase tracking-tighter ${isActive ? 'text-primary' : 'text-white'}`}
    >
      {children}
    </Link>
  );
}
